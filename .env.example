# Claude Science API Bridge Configuration
# Copy this file to .env, fill in the actual values, then run: docker compose up -d
#
# Default setup: all requests go to the DeepSeek official API
# (DEFAULT_BACKEND=deepseek). The default model is deepseek-v4-flash-vision-exp,
# shown as "DeepSeek V4 Flash" in the model selector; image requests fall back to
# the same DeepSeek vision model automatically.

# --- DeepSeek Backend (official API, default) ---
# API Key (required)
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_UPSTREAM_MODE=anthropic       # openai / anthropic

# Default backend: deepseek / openai / custom
# DEFAULT_BACKEND=deepseek

# Force-specified model name (takes precedence over default_backend;
# ignored when MODEL_ALIASES is set)
# FORCE_MODEL=deepseek-v4-flash-vision-exp

# Upstream protocol mode for the custom backend: openai / anthropic
# CUSTOM_UPSTREAM_MODE=openai

# Image handling policy: preserve / omit / omit_inline / auto
# INLINE_IMAGE_POLICY=preserve

# Reasoning/thinking content policy: never / auto / preserve
# When "never", strips thinking blocks incompatible with non-Anthropic backends
# REASONING_CONTENT_POLICY=never

# --- Image Fallback (vision model for image requests) ---
# When the selected model is text-only (e.g. DeepSeek) but the request contains
# an image, the bridge can fall back to a vision model for that request.
# image_fallback_mode: auto (default) / off
# IMAGE_FALLBACK_MODE=auto
# Backend used for the fallback: deepseek / openai / custom
# IMAGE_FALLBACK_BACKEND=deepseek
# Vision model to use for image requests (must be a model ID valid on DEEPSEEK_BASE_URL)
# IMAGE_FALLBACK_MODEL=deepseek-v4-flash-vision-exp

# --- Custom Backend (optional; e.g., SiliconFlow, Moonshot AI, etc.) ---
# API Key (required)
# CUSTOM_API_KEY=sk-your-api-key-here

# Third-party API endpoint
# CUSTOM_BASE_URL=https://api.siliconflow.cn

# --- OpenAI Backend (optional) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com

# --- GPU Passthrough into the code-execution sandbox ---
# claude-science keeps GPU off unless config.toml sets gpu_enabled = true.
# The entrypoint sets it automatically when a GPU is present (ENABLE_GPU=auto,
# default), always (true), or never (false). When on, the sandbox gets
# /dev/nvidia* + /sys/module/nvidia* and CUDA libs are visible under /usr.
# GPU is mounted into the container via CDI (see the README "GPU Support"
# section): docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# ENABLE_GPU=auto

# --- Multi-Model Configuration (model_aliases) ---
# When set, enables model aliases mode for multi-model support.
# This overrides FORCE_MODEL and shows multiple models in Claude Science's model selector.
# Set as a JSON array; each entry maps a Claude-compatible ID to a real backend model.
#
# Default (single model): the model selector shows "DeepSeek V4 Flash" while the
# bridge sends deepseek-v4-flash-vision-exp to the DeepSeek official API.
# MODEL_ALIASES='[{"id":"claude-haiku-4-5","display_name":"DeepSeek V4 Flash","backend":"deepseek","model":"deepseek-v4-flash-vision-exp"}]'
#
# Example: DeepSeek Flash + Pro both available:
# MODEL_ALIASES='[{"id":"claude-haiku-4-5","display_name":"DeepSeek V4 Flash","backend":"deepseek","model":"deepseek-v4-flash-vision-exp"},{"id":"claude-sonnet-5","display_name":"DeepSeek V4 Pro","backend":"deepseek","model":"deepseek-v4-pro"}]'
#
# The entrypoint auto-sets model_list_mode=aliases + model_menu_strategy=claude_compatible
# when MODEL_ALIASES is provided. Override them manually if needed:
# MODEL_LIST_MODE=aliases
# MODEL_MENU_STRATEGY=claude_compatible