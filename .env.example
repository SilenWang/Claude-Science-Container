# Claude Science API Bridge Configuration
# Copy this file to .env, fill in the actual values, then run: docker compose up -d
#
# Default setup: all requests go to the DeepSeek official API
# (DEFAULT_BACKEND=deepseek). The default model is deepseek-flash, shown as
# "DeepSeek Flash" in the model selector. deepseek-flash is a text-only model,
# so images have no vision path: base64 inline images are dropped by default
# (INLINE_IMAGE_POLICY=omit_inline) and the bridge adds a placeholder note.

# --- DeepSeek Backend (official API, default) ---
# API Key (required)
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_UPSTREAM_MODE=openai         # openai / anthropic（anthropic 目前仅告警，仍按 openai 处理）

# Default backend: deepseek / openai / custom
# DEFAULT_BACKEND=deepseek

# Force-specified model name. It is used for every request that is not mapped by
# MODEL_ALIASES and whose own backend is not usable (no *_API_KEY configured).
# An alias always wins; a request that matches DEEPSEEK_MODEL_PATTERN /
# OPENAI_MODEL_PATTERN / CUSTOM_MODEL_PATTERN with a configured backend is sent
# to that backend unchanged instead. Requests that fall back to this value
# (including built-in model IDs such as gpt-4o when OPENAI_API_KEY is unset) log
# one warning per requested -> forced pair. See README "Model mapping".
# FORCE_MODEL=deepseek-flash

# Upstream protocol mode for the custom backend: openai / anthropic
# CUSTOM_UPSTREAM_MODE=openai

# Image handling policy: omit_inline / omit / preserve / auto
#   omit_inline  drop base64 inline images, keep http(s) URL images (default)
#   omit         drop every image block
#   preserve     keep every image block (only useful with a vision model)
#   auto         omit on the DeepSeek backend, preserve on the others
# The default model deepseek-flash is text-only, so pasted images are dropped
# rather than sent to a model that cannot read them. Set preserve only after
# switching FORCE_MODEL / MODEL_ALIASES to a vision model.
# When every image in a message is dropped, the bridge adds a short placeholder
# text so the upstream never receives an empty user message (OpenAI returns 400
# for those).
# INLINE_IMAGE_POLICY=omit_inline

# Reasoning/thinking content policy: never / auto / preserve
# NOTE: the Go bridge currently reads no value from this variable. Upstream
# reasoning_content is always dropped (Anthropic-compatible clients cannot see
# it) and Anthropic thinking blocks are not forwarded.
# REASONING_CONTENT_POLICY=never

# --- Image Fallback (currently not implemented) ---
# IMAGE_FALLBACK_* is passed through by docker-compose but the Go bridge does
# not read it yet, so it has no effect. Images are forwarded according to
# INLINE_IMAGE_POLICY; the default model deepseek-flash is text-only, so the
# default policy drops inline images instead of routing them anywhere.
# IMAGE_FALLBACK_MODE=auto
# IMAGE_FALLBACK_BACKEND=deepseek
# IMAGE_FALLBACK_MODEL=deepseek-flash

# --- Custom Backend (optional; e.g., SiliconFlow, Moonshot AI, etc.) ---
# API Key (required)
# CUSTOM_API_KEY=sk-your-api-key-here

# Third-party API endpoint
# CUSTOM_BASE_URL=https://api.siliconflow.cn

# --- OpenAI Backend (optional) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com

# --- Fake login (BYOK) ---
# On first run the entrypoint lets claude-science create
# ~/.claude-science/encryption.key, then calls `api-bridge setup-token`.
# The Go bridge reads OAUTH_ENCRYPTION_KEY= from that file and writes a
# Fernet-encrypted fake OAuth token to ~/.claude-science/.oauth-tokens/
# (directory 0700, file 0600). There is no Python setup-token.py dependency.

# --- GPU Passthrough into the code-execution sandbox ---
# claude-science keeps GPU off unless config.toml sets gpu_enabled = true.
# The entrypoint sets it automatically when a GPU is present (ENABLE_GPU=auto,
# default), always (true), or never (false). When on, the sandbox gets
# /dev/nvidia* + /sys/module/nvidia* and CUDA libs are visible under /usr.
# GPU is mounted into the container via CDI (see the README "GPU Support"
# section): docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# ENABLE_GPU=auto

# --- Multi-Model Configuration (MODEL_ALIASES) ---
# A JSON array mapping each Claude-compatible ID to a real backend model.
# Requests whose model matches an alias use that alias's backend/model. Every
# other request is matched against *_MODEL_PATTERN first (an already-configured
# backend keeps the requested model name) and otherwise falls back to
# FORCE_MODEL on DEFAULT_BACKEND.
#
# Default (single model): the model selector shows "DeepSeek Flash" while the
# bridge sends deepseek-flash to the DeepSeek official API.
# MODEL_ALIASES='[{"id":"claude-haiku-4-5","display_name":"DeepSeek Flash","backend":"deepseek","model":"deepseek-flash"}]'
#
# Example: DeepSeek Flash + Pro both available:
# MODEL_ALIASES='[{"id":"claude-haiku-4-5","display_name":"DeepSeek Flash","backend":"deepseek","model":"deepseek-flash"},{"id":"claude-sonnet-5","display_name":"DeepSeek V4 Pro","backend":"deepseek","model":"deepseek-v4-pro"}]'
#
# GET /v1/models is built from MODEL_ALIASES + MODEL_LIST_MODE:
#   aliases (alias / third_party)   only alias entries
#   builtin (compat)                only the built-in model list
#   aliases_first (mixed)           alias entries followed by built-ins
#   unset                           aliases when MODEL_ALIASES is non-empty,
#                                   otherwise built-ins
# When the resulting list is empty, first_id/last_id are null and has_more is false.
# MODEL_LIST_MODE=aliases
#
# MODEL_MENU_STRATEGY is still passed through by docker-compose but the Go
# bridge does not read it (no effect).
# MODEL_MENU_STRATEGY=claude_compatible
